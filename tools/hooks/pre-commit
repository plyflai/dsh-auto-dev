#!/usr/bin/env bash
# 只在碰到插件本身（工具/文案/投影/面板/测试）时才跑台子：
# 改文档、改图、改场景数据不该被拦。
set -u
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if ! printf '%s\n' "$staged" | grep -Eq '^(src/|tests/|tools/|package\.json$)'; then
  exit 0
fi
echo "dsh-auto-dev: 改动涉及 src/tests/tools —— 跑一遍检查台（npm run check）…"
# git 给钩子注入的 GIT_INDEX_FILE 等会漏进测试里的临时仓库（commit -a 时指向临时索引）
unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_PREFIX
if ! npm run --silent check; then
  echo
  echo "检查没通过。回执/面板/单元测试有一处不达预期，修完再提交；"
  echo "确实要跳过就 git commit --no-verify（并说明原因）。"
  exit 1
fi
echo "检查通过。"
